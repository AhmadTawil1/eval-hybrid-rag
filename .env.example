OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5.6-terra
JUDGE_EMBEDDING_MODEL=text-embedding-3-small

# Public-demo protection (defaults shown)
MAX_OUTPUT_TOKENS=4000
ANSWERS_PER_VISITOR_PER_HOUR=5
DAILY_ANSWERS_LIMIT=80
SEARCHES_PER_VISITOR_PER_MINUTE=60
# Set to true only when the app runs behind a proxy you control that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Only needed for a hosted Qdrant (defaults to http://localhost:6333)
# QDRANT_URL=
# QDRANT_API_KEY=
